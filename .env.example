# Environment
NODE_ENV=
# Comments providers
GISCUS_REPO=
GISCUS_REPOSITORY_ID=
GISCUS_CATEGORY=
GISCUS_CATEGORY_ID=
UTTERANCES_REPO=
DISQUS_SHORTNAME=
NEXT_PUBLIC_CREATE_DISCUS_ON_TWITTER=TRUE
NEXT_PUBLIC_CREATE_DISCUS_ON_GITHUB=TRUE
NEXT_PUBLIC_SHARE_ON_FACEBOOK=TRUE
NEXT_PUBLIC_SHARE_ON_TWITTER=TRUE

# GitHub (for fetching repository's data in /projects page)
GITHUB_API_TOKEN=

# Default locale (for i18n)
NEXT_PUBLIC_DEFAULT_LOCALE=vi

# Database for post views
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Admin (/admin)
# Only for `yarn dev`: skip GitHub login and read/write posts in the local data/ folder
ADMIN_LOCAL_MODE=
# GitHub OAuth App for login. Callback URL: https://<domain>/api/admin/callback/
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Only this GitHub account can log in
ADMIN_GITHUB_USERNAME=
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=
# Fine-grained token with "Contents: Read and write" on the blog repo
GITHUB_CONTENT_TOKEN=
GITHUB_CONTENT_REPO=MrTus97/TuPTdev
GITHUB_CONTENT_BRANCH=main
# Claude API key for translating posts
ANTHROPIC_API_KEY=
